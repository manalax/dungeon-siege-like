; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Siege-like"
config/description="Party-based dungeon-extraction ARPG with shopkeeping."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
InputMapSetup="*res://autoload/input_map_setup.gd"
Game="*res://autoload/game.gd"
DebugConsole="*res://autoload/debug_console.gd"
Calendar="*res://autoload/calendar.gd"
Economy="*res://autoload/economy.gd"
Roster="*res://autoload/roster.gd"
Party="*res://autoload/party.gd"
RunManager="*res://autoload/run_manager.gd"
WorldStreamer="*res://autoload/world_streamer.gd"
ItemFactory="*res://autoload/item_factory.gd"
LootService="*res://autoload/loot_service.gd"
ShopManager="*res://autoload/shop_manager.gd"
Market="*res://autoload/market.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"

[dotnet]

project/assembly_name="Siege-like"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

